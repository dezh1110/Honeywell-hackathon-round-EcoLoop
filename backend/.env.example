# --- Simulation backend ---
# "mock" runs a lightweight RC thermal model (no EnergyPlus install needed) --
# use this to develop/demo the agent + MCP + dashboard end to end.
# "energyplus" runs the real EMS-driven closed loop; requires a local install.
SIMULATION_BACKEND=mock

# --- EnergyPlus (only used when SIMULATION_BACKEND=energyplus) ---
ENERGYPLUS_INSTALL_DIR=/usr/local/EnergyPlus-24-1-0
IDF_PATH=models/small_office.idf
EPW_PATH=models/weather/bengaluru.epw
OUTPUT_DIR=/tmp/ecoloop_runs
AGENT_DECISION_EVERY_N_TIMESTEPS=3

# --- OSS LLM (any OpenAI-compatible endpoint: Ollama, vLLM, LM Studio, TGI) ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2:3b
LLM_TEMPERATURE=0.2

# --- MCP server (only relevant if you run app.mcp.server standalone) ---
MCP_TRANSPORT=stdio
MCP_SSE_PORT=8765

# --- Grid carbon intensity ---
CARBON_INTENSITY_PROVIDER=static
# CARBON_INTENSITY_API_KEY=
# CARBON_INTENSITY_ZONE=IN-KA

# --- Supabase (same project the React dashboard points at) ---
# Use the SERVICE ROLE key here (server-side only) -- never the anon key,
# and never commit a real value.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# --- Safety bounds ---
MIN_COOLING_SETPOINT_C=21.0
MAX_COOLING_SETPOINT_C=26.0
MIN_HEATING_SETPOINT_C=18.0
MAX_HEATING_SETPOINT_C=22.0
