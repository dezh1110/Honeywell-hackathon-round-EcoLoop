# Used by `docker-compose.yml` to build the dashboard and pass credentials
# to the backend agent container. Copy to `.env` and fill in.
#
# Memory note: the full stack (EnergyPlus + Ollama + the dashboard build)
# is heaviest during the LLM reasoning calls. Give Docker Desktop at least
# 6-8GB of memory (Settings > Resources > Memory) before starting, or the
# Ollama model process can get OOM-killed mid-run -- the agent handles that
# gracefully (holds setpoints, logs a warning) rather than crashing, but
# it's better avoided. LLM_MODEL defaults to llama3.2:3b (~2-3GB) partly to
# reduce this risk versus a larger model.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side only — never expose this to the browser/frontend build.
SUPABASE_SERVICE_KEY=your-service-role-key

# energyplus (real EnergyPlus, baked into the backend image, this is the
# compose default) | mock (no EnergyPlus needed, faster first run)
SIMULATION_BACKEND=energyplus

# Optional overrides — uncomment to customize:
# LLM_MODEL=llama3.2:3b
# EPW_PATH=/path/inside/container/to/your-site.epw
